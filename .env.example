# Example environment variables for Flask app using MySQL (PyMySQL)
# Preferred: set a full SQLALCHEMY_DATABASE_URI
# Example: mysql+pymysql://user:password@localhost:3306/webdknckh

# Option 1: full URI
# SQLALCHEMY_DATABASE_URI=mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# Option 2: set components (used by config to construct URI)
MYSQL_USER=webuser
MYSQL_PASSWORD=secret_password_here
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=webdknckh

# Alternatively you can set a DATABASE_URL env var (common in hosting):
# DATABASE_URL=mysql+pymysql://user:password@host:port/dbname

# Flask settings
FLASK_ENV=production
FLASK_APP=run.py

# Optional: app-specific flags
# SKIP_SEED=false
